rules_version = '2';

// ═══════════════════════════════════════════════════════════════════
//  GROT-X — Firestore Security Rules
//  Zero-trust client. All privileged ops validated server-side.
//
//  Threat model covered here:
//   T1  Privilege escalation  (isPremium/role/coachLimit via client write)
//   T2  Relation spoofing     (coach↔student without mutual consent)
//   T3  Data mining           (world_queue enumeration, other users' sessions)
//   T4  Ranking fraud         (arbitrary worldXP/worldWins increments)
//   T5  Battle tampering      (non-host mutating participants, cross-player score edit)
//   T6  Cross-tenant writes   (writes to other users' subcollections)
//   T7  Admin impersonation   (non-admin writing announcements, clubs, stats)
//
//  TODO (Faza B, when Cloud Functions land):
//   - Move world_stats writes to server; block client writes entirely.
//   - Move premium grants to callable function (Stripe webhook).
//   - Move coach-student add to callable (server writes both sides atomically).
// ═══════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // [GOŚĆ] Konto anonimowe (tryb gościa, dane TTL 24h) — bez dostępu do
    // funkcji społecznościowych: battles, ranking światowy, relacje trenerskie,
    // publiczne lustro profilu. TTL skasowałby ich wpisy → duchy w rankingach.
    function isAnon() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function isAdmin() {
      // email_verified wymagane: bez tego rejestracja e-mail+hasło na cudzy
      // (jeszcze niezajęty) adres dawałaby uprawnienia admina. Konta Google
      // mają email_verified == true automatycznie. Migrate to custom claims
      // (request.auth.token.admin == true) when Cloud Functions land.
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
             'info@aves-24.de',
             'rafal.woropaj@googlemail.com'
           ];
    }
    // trialEndsAt: klient może zapisać tylko sensowną wartość — maks. 31 dni
    // od teraz. Bez tego limitu można sobie ustawić trial "na zawsze".
    function validTrialEndsAt(data) {
      return data.trialEndsAt is number
        && data.trialEndsAt <= request.time.toMillis() + 41 * 24 * 60 * 60 * 1000;
    }
    // [ZESTAWY] Limit zestawow sprzetowych: 1 FREE / 4 PRO.
    //
    // Bez tego limit zyje wylacznie w UI, a UI nie jest granica bezpieczenstwa
    // — kazdy moze wpisac sobie 40 zestawow z konsoli przegladarki i ominac
    // roznice miedzy FREE a PRO, czyli platna funkcje.
    //
    // Limit podaje wolajacy, bo `isPremium` czyta sie inaczej przy create
    // (dokument jeszcze nie istnieje) niz przy update. `isPremium` jest polem
    // chronionym (protectedUserFields), wiec klient go nie podniesie, zeby
    // sobie limit rozszerzyc.
    //
    // OGRANICZENIE: reguly Firestore nie maja petli, wiec NIE da sie tu
    // sprawdzic dlugosci nazwy ani notatki w KAZDYM zestawie z osobna.
    // Te limity (nazwa 40, notatka 100) egzekwuje tylko UI przez `maxLength`.
    // `prevCount` to liczba zestawow w dokumencie PRZED zapisem (0 przy create).
    // Bez niej wygasniecie PRO zamurowaloby konto: uzytkownik z 4 zestawami
    // spada na limit 1 i KAZDY kolejny zapis profilu — nawet zmiana nazwiska —
    // leci odmowa, bo `setups` jedzie w kazdym merge'u. Dlatego nadmiarowe
    // zestawy wolno TRZYMAC i zmniejszac, byle ich nie przybywalo.
    function validSetups(data, limit, prevCount) {
      return !data.keys().hasAny(['setups'])
        || (data.setups is list
            && (data.setups.size() <= limit
                || data.setups.size() <= prevCount));
    }
    // [C25] Sufit liczby dystansow — funkcja PLATNA, tak jak zestawy sprzetowe.
    // Wlasnych wpisow: 2 na FREE, 15 na PRO (decyzja usera 2026-09-04).
    //
    // Limit podany tu jest sufitem CALEJ listy, nie samych wpisow wlasnych:
    // 10 standardowych + 2 = 12 (FREE), 10 + 15 = 25 (PRO). Jezyk regul nie ma
    // petli ani filtrowania, wiec nie da sie policzyc, ile pozycji jest
    // "wlasnych". Wychodzi na to samo, bo klient zawsze odtwarza komplet
    // dziesieciu standardowych (`rebuildMasterList`).
    // Lustro: CUSTOM_DISTANCE_LIMIT_FREE/PRO w src/config/distances.ts.
    //
    // Limit podaje wolajacy — `isPremium` czyta sie inaczej przy create niz
    // przy update. Pole jest chronione (protectedUserFields), wiec klient nie
    // podniesie go sobie w tym samym zapisie, zeby przemycic wiecej wpisow.
    //
    // `prevCount` dziala tak jak przy zestawach: po wygasnieciu PRO nadmiarowe
    // dystanse wolno TRZYMAC i zmniejszac, byle nie przybywalo. Bez tego konto
    // z 15 wlasnymi wpisami zamurowaloby sie na kazdym zapisie profilu — nawet
    // na zmianie nazwiska — bo `userDistances` jedzie w kazdym merge'u.
    function validDistances(data, limit, prevCount) {
      return !data.keys().hasAny(['userDistances'])
        || (data.userDistances is list
            && (data.userDistances.size() <= limit
                || data.userDistances.size() <= prevCount));
    }
    // PRO w tej chwili: stałe, globalna promocja albo trial/prezent od admina
    // (trialEndsAt w przyszłości). Z tego idą limity zestawów i dystansów —
    // wcześniej tylko `isPremium`, więc trial i prezent dostawały limity FREE.
    // LUSTRO: src/utils/proAccess.ts.
    //
    // Czytane ZAWSZE z `resource` (stan przed zapisem): trialEndsAt po pierwszym
    // ustawieniu jest zablokowane dla klienta (Path B), isPremium/isPremiumPromo
    // są chronione — nikt nie podniesie sobie limitu w tym samym zapisie.
    // `is number` najpierw: stare „Odbierz PRO" zapisuje trialEndsAt jako napis
    // ISO z przeszłości, a porównanie napisu z liczbą byłoby błędem reguły.
    function hasActivePro(data) {
      return data.get('isPremium', false) == true
        || data.get('isPremiumPromo', false) == true
        || (data.get('trialEndsAt', 0) is number
            && data.get('trialEndsAt', 0) > request.time.toMillis());
    }
    // [TRENER] Miejsca dla uczniów. Każdy może sam włączyć tryb trenera
    // (`isCoach` nie jest chronione) i dostaje 1 miejsce za darmo. Więcej
    // tylko przez `coachLimit`, które pisze admin (pakiety; pole chronione).
    // LUSTRO: src/utils/coachAccess.ts (FREE_COACH_SLOTS).
    function coachSlots(data) {
      return data.get('coachLimit', 0) is number && data.get('coachLimit', 0) > 1
        ? data.get('coachLimit', 0)
        : 1;
    }
    function validActiveSetupId(data) {
      return !data.keys().hasAny(['activeSetupId'])
        || data.activeSetupId is string;
    }

    // Fields NEVER writable by the client on /users/{uid}
    function protectedUserFields() {
      return [
        'isPremium', 'isPremiumPromo',
        'coachLimit', 'role',
        'worldWins', 'worldLosses', 'worldXP',
        'students', 'coaches'  // relations — only via invite flows below
        // NOTE: 'level' removed — it is derived from the client-computed
        // handicap (hcByBow) and written by ScoringView on every training save.
      ];
    }
    // affectedKeys subset check helper
    function onlyAffects(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    function noneAffected(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }
    // Size check
    function listLen(data, field) {
      return data.get(field, []).size();
    }
    // Accepted coach invite exists
    function coachInviteExists(coachId, studentId) {
      return exists(/databases/$(database)/documents/coachInvites/$(coachId + '_' + studentId));
    }
    // [RODO] Pola wrażliwe NIE mogą istnieć w users/{uid} (czytelnym dla
    // relacji trener↔uczeń) — żyją w users/{uid}/private/profile.
    // Sprawdzamy stan dokumentu PO zapisie: usunięcie pól (migracja) przechodzi,
    // dodanie/zmiana — nie.
    function sensitiveUserFields() {
      return ['email', 'birthDate', 'gender'];
    }
    // world_stats: dokument publiczny (leaderboard) — twardy kształt i limity
    // długości, żeby nikt nie doklejał obcych pól ani kilometrowych nazw.
    function validWorldStatsShape(data) {
      return data.keys().hasOnly(
               ['userId', 'displayName', 'clubName', 'country', 'level',
                'worldWins', 'worldLosses', 'worldXP', 'lastWorldBattle'])
        && data.get('displayName', '') is string
        && data.get('displayName', '').size() <= 80
        && data.get('clubName', '') is string
        && data.get('clubName', '').size() <= 120
        && data.get('country', '') is string
        && data.get('country', '').size() <= 40;
    }

    // ─── /users/{uid} ───────────────────────────────────────────
    //  [RODO C6] Profil czytelny TYLKO dla: właściciela, admina i osób
    //  w relacji trener↔uczeń (dashboard trenera: rangi, sprzęt, lastSession*).
    //  [RODO C21] Pola wrażliwe (e-mail, data urodzenia, płeć) NIE istnieją
    //  w tym dokumencie — patrz users/{uid}/private/profile; trener widzi
    //  wyliczoną kategorię wiekową (ageCategory).
    //  Dane do publicznego wyświetlania → /profiles_public/{uid}.
    //  UWAGA: warunki na resource.data działają dla getDoc per-dokument;
    //  zapytania listowe po users (poza adminem) NIE przejdą — klienci
    //  czytają pojedynczo (SettingsView, CoachDashboard, MyCoach).
    match /users/{uid} {
      allow read: if isSelf(uid)
        || isAdmin()
        || (isSignedIn()
            && (request.auth.uid in resource.data.get('coaches', [])
                || request.auth.uid in resource.data.get('students', [])));

      allow create: if isSelf(uid)
        && !request.resource.data.keys().hasAny(protectedUserFields())
        && !request.resource.data.keys().hasAny(sensitiveUserFields())
        && (!request.resource.data.keys().hasAny(['trialEndsAt'])
            || validTrialEndsAt(request.resource.data))
        // [ZESTAWY] Przy zakladaniu konta limit to zawsze 1: `isPremium` jest
        // polem chronionym, wiec nowy dokument nie moze przyjsc jako PRO.
        && validSetups(request.resource.data, 1, 0)
        // Nowe konto nie moze przyjsc jako PRO (pole chronione), wiec 13 + 2.
        // 13 = 10 dystansow luczniczych + 3 dmuchawkowe (2026-09-08); lustro
        // MASTER_DISTANCE_COUNT w src/config/distances.ts.
        && validDistances(request.resource.data, 15, 0)
        && validActiveSetupId(request.resource.data);

      // Path A — admin full
      allow update: if isAdmin();

      // Path B — self-edit profile (no protected fields, no relations)
      // trialEndsAt may be written once on first-time init (when not previously set)
      // and only with a bounded value (max now + 41 days: 40-day trial + margin, see validTrialEndsAt);
      // once present it is locked — client cannot change it (matches code comment).
      allow update: if isSelf(uid)
        && noneAffected(['isPremium', 'isPremiumPromo',
                         'coachLimit', 'role',
                         'worldWins', 'worldLosses', 'worldXP',
                         'students', 'coaches'])
        // Pola wrażliwe: nietknięte (legacy doc sprzed migracji) LUB nieobecne
        // po zapisie (migracja je usuwa). Dodanie/zmiana — zablokowane.
        && (noneAffected(sensitiveUserFields())
            || !request.resource.data.keys().hasAny(sensitiveUserFields()))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['trialEndsAt'])
            || (!resource.data.keys().hasAny(['trialEndsAt'])
                && validTrialEndsAt(request.resource.data)))
        // [ZESTAWY] Limit czytany z ISTNIEJACEGO dokumentu — pola PRO sa
        // chronione (trialEndsAt zablokowane po pierwszym zapisie), wiec klient
        // nie moze ich podniesc w tym samym zapisie, zeby przemycic wiecej zestawow.
        && validSetups(request.resource.data,
                       hasActivePro(resource.data) ? 4 : 1,
                       listLen(resource.data, 'setups'))
        // 13 standardowych (10 luczniczych + 3 dmuchawkowe) + 2 FREE / 15 PRO.
        && validDistances(request.resource.data,
                          hasActivePro(resource.data) ? 28 : 15,
                          listLen(resource.data, 'userDistances'))
        && validActiveSetupId(request.resource.data);

      // Path C — student accepting invite: own doc, diff = ['coaches'],
      //          +1 entry, last entry has matching coachInvite.
      allow update: if isSelf(uid)
        && onlyAffects(['coaches'])
        && listLen(request.resource.data, 'coaches') == listLen(resource.data, 'coaches') + 1
        && coachInviteExists(
             request.resource.data.coaches[listLen(request.resource.data, 'coaches') - 1],
             uid
           );

      // Path D — student removing a coach from own list: diff ['coaches'], size -1
      allow update: if isSelf(uid)
        && onlyAffects(['coaches'])
        && listLen(request.resource.data, 'coaches') == listLen(resource.data, 'coaches') - 1;

      // Path E — student writes to COACH's doc, adding self to students[]
      //          requires coachInvite(uid, self) exists.
      //          [TRENER] Wcześniej limit uczniów pilnowało tylko UI — teraz
      //          dokument musi być trenerem i mieć wolne miejsce (coachSlots).
      //          Nadmiar sprzed zmiany limitu zostaje; nie przybywa ponad limit.
      allow update: if isSignedIn()
        && !isSelf(uid)
        && onlyAffects(['students'])
        && listLen(request.resource.data, 'students') == listLen(resource.data, 'students') + 1
        && request.resource.data.students[listLen(request.resource.data, 'students') - 1]
             == request.auth.uid
        && coachInviteExists(uid, request.auth.uid)
        && resource.data.get('isCoach', false) == true
        && listLen(resource.data, 'students') < coachSlots(resource.data);

      // Path F — student self-removes from coach's students[]
      allow update: if isSignedIn()
        && !isSelf(uid)
        && onlyAffects(['students'])
        && listLen(request.resource.data, 'students') == listLen(resource.data, 'students') - 1
        && !(request.auth.uid in request.resource.data.students)
        && (request.auth.uid in resource.data.get('students', []));

      // Path G — coach removes a student (coach = self, own doc)
      allow update: if isSelf(uid)
        && onlyAffects(['students'])
        && listLen(request.resource.data, 'students') == listLen(resource.data, 'students') - 1;

      // Path H — coach removes OWN uid from student's coaches[] (when cutting off a student)
      allow update: if isSignedIn()
        && !isSelf(uid)
        && onlyAffects(['coaches'])
        && listLen(request.resource.data, 'coaches') == listLen(resource.data, 'coaches') - 1
        && !(request.auth.uid in request.resource.data.coaches)
        && (request.auth.uid in resource.data.get('coaches', []));

      // Path I — message sender sets unreadMsgFrom on recipient's doc.
      //          Sender must be in a coach-student relationship with recipient.
      //          Only unreadMsgFrom may change (notification flag, not sensitive data).
      allow update: if isSignedIn()
        && !isSelf(uid)
        && onlyAffects(['unreadMsgFrom'])
        && (request.auth.uid in resource.data.get('coaches', [])
            || request.auth.uid in resource.data.get('students', []));

      // Path K — coach adjusts student's focus-goal count (liczba lekcji).
      //          Niezalezne od tego kto ustawil aktualny temat fokusu (dziennik
      //          jest append-only, wiec bez tego trzeba by bylo tworzyc nowy
      //          wpis w coachLog, co resetowaloby date startu i postep).
      allow update: if isSignedIn()
        && !isSelf(uid)
        && onlyAffects(['focusGoal', 'focusDots'])
        && request.auth.uid in resource.data.get('coaches', [])
        && request.resource.data.get('focusGoal', 2) in [1, 2, 3, 4, 5]
        && request.resource.data.get('focusDots', false) is bool;

      // Path L — coach ends the student's active focus early. Writes the SAME
      // "cleared" marker the student's own end-focus flow writes (see
      // TagebuchView endFocus) — never a fabricated topic/text pretending to
      // be the student's own choice, only this exact clear shape, so provenance
      // stays honest even though the UI doesn't show who ended it.
      // Optional `ended` = snapshot of the focus being ended, so it stays in
      // the student's journal as "last ended focus" (same as the student's
      // own flow). Shape-checked only; the coach already sees this focus.
      allow update: if isSignedIn()
        && !isSelf(uid)
        && onlyAffects(['focus'])
        && request.auth.uid in resource.data.get('coaches', [])
        && request.resource.data.focus.keys().hasOnly(['cleared', 'setAt', 'ended'])
        && request.resource.data.focus.cleared == true
        && request.resource.data.focus.setAt is number
        && (!('ended' in request.resource.data.focus)
            || (request.resource.data.focus.ended is map
                && request.resource.data.focus.ended.keys().hasOnly(
                     ['text', 'topic', 'since', 'fromCoach', 'authorName', 'step', 'goal'])
                && request.resource.data.focus.ended.text is string
                && request.resource.data.focus.ended.text.size() <= 120
                && request.resource.data.focus.ended.topic is string
                && request.resource.data.focus.ended.topic.size() <= 60
                && request.resource.data.focus.ended.since is number));

      // Path J — any signed-in user can append their coach request ID to the
      //          admin's newCoachRequests notification array (write-only signal,
      //          no sensitive data). Only the admin UID is the target.
      allow update: if isSignedIn()
        && uid == 'b55wNdZf17gH5wxziuzG9bkaQKo2'
        && onlyAffects(['newCoachRequests'])
        && listLen(request.resource.data, 'newCoachRequests')
             == listLen(resource.data, 'newCoachRequests') + 1;

      // DELETE: właściciel (RODO art. 17 — usuwanie konta w aplikacji,
      // wymóg Apple/Google dla appek z kontami) lub admin.
      allow delete: if isSelf(uid) || isAdmin();
    }

    // ─── /users/{uid}/private/{docId} ───────────────────────────
    //  [RODO] Pola wrażliwe (birthDate, gender) — TYLKO właściciel i admin.
    //  Trener widzi wyliczoną kategorię wiekową (users/{uid}.ageCategory),
    //  nie datę urodzenia. E-mail nie jest przechowywany w Firestore
    //  (żyje w Firebase Auth).
    match /users/{uid}/private/{docId} {
      allow read, write: if isSelf(uid) || isAdmin();
    }

    // ─── /profiles_public/{uid} ─────────────────────────────────
    //  [RODO C6] Publiczne lustro profilu — wyłącznie dane, które
    //  użytkownik zgodził się pokazywać (flagi showFullName/showClub itd.
    //  egzekwuje klient w buildPublicProfile; tu twarde limity pól).
    //  Pisane przez App.tsx przy zmianie users/{uid}.
    match /profiles_public/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSelf(uid)
        && !isAnon()
        && request.resource.data.keys().hasOnly(
             ['displayName', 'club', 'country', 'level', 'updatedAt'])
        && request.resource.data.get('displayName', '') is string
        && request.resource.data.get('displayName', '').size() <= 80
        && request.resource.data.get('club', '') is string
        && request.resource.data.get('club', '').size() <= 120
        && request.resource.data.get('country', '') is string
        && request.resource.data.get('country', '').size() <= 40;
      allow delete: if isSelf(uid) || isAdmin();
    }

    // ─── /users/{uid}/sessions/{sessionId} ──────────────────────
    //  Owner full. Coach read-only if in user.coaches[].
    //  NOTE: isNotePublic is not enforced here — Firestore list queries
    //  reject per-document resource.data conditions without a matching
    //  WHERE clause, which blocks the entire query for coaches.
    match /users/{uid}/sessions/{sessionId} {
      allow read: if isSelf(uid)
        || isAdmin()
        || (isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('coaches', []));

      // Self/Admin create/delete, update with length limits
      allow create, delete: if isSelf(uid) || isAdmin();

      allow update: if (isSelf(uid) || isAdmin())
        && request.resource.data.get('note', '').size() <= 2000
        && request.resource.data.get('coachNote', '').size() <= 500;

      // Coach writes coachNote + coachEditCount + coachTopics (length limited).
      // coachTopics wysyła CoachNoteModule przy każdym zapisie — bez niego na
      // liście każdy zapis notatki trenera był odrzucany.
      allow update: if isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('coaches', [])
        && onlyAffects(['coachNote', 'coachEditCount', 'coachTopics'])
        && request.resource.data.coachNote.size() <= 500
        && request.resource.data.get('coachTopics', []) is list
        && request.resource.data.get('coachTopics', []).size() <= 20;

      // Trener odhacza notatkę ucznia jako przeczytaną bez odpowiedzi (karta
      // ucznia, user 2026-09-18). Tylko własny uid i czas serwera.
      allow update: if isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('coaches', [])
        && onlyAffects(['coachSeenAt', 'coachSeenBy'])
        && request.resource.data.coachSeenBy == request.auth.uid
        && request.resource.data.coachSeenAt == request.time;
    }

    // ─── /users/{uid}/sessionNotes/{sessionId} ──────────────────
    //  [RODO C36] Tekst notatki treningowej oznaczonej jako „Prywatna”.
    //  Sesję czyta trener (całą), więc prywatny tekst NIE może w niej leżeć.
    //  Trener nie ma tu dostępu. Id = id sesji. Patrz utils/privateSessionNote.ts
    match /users/{uid}/sessionNotes/{sessionId} {
      allow read, delete: if isSelf(uid) || isAdmin();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['note', 'updatedAt', 'expiresAt', 'isGuest'])
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 2000;
    }

    // ─── /users/{uid}/techShots/{shotId} ────────────────────────
    match /users/{uid}/techShots/{shotId} {
      allow read: if isSelf(uid)
        || isAdmin()
        || (isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('coaches', []));
      allow create, delete: if isSelf(uid) || isAdmin();
      allow update: if isSelf(uid) || isAdmin();
    }

    // ─── /users/{uid}/coachLog/{entryId} ────────────────────────
    //  Wspólny dziennik trenerski — wszyscy trenerzy ucznia widzą wpisy
    //  każdego z trenerów (continuity przy zastępstwach). Uczeń też może
    //  czytać (przyszły MyCoachView). Edycja zablokowana, kasować może
    //  autor wpisu, admin lub uczeń-właściciel (RODO art. 17 — wpisy dotyczą
    //  ucznia i muszą zniknąć przy usuwaniu jego konta).
    // [LINKI W TEMACIE 2026-10-16] do 3 linków http(s), każdy ≤ 500 znaków.
    function okTopicLink(u) {
      return u is string && u.size() <= 500 && u.matches('https?://[^\\s]+');
    }
    function okTopicLinks(d) {
      return !('links' in d)
        || (d.links is list
            && d.links.size() <= 3
            && (d.links.size() < 1 || okTopicLink(d.links[0]))
            && (d.links.size() < 2 || okTopicLink(d.links[1]))
            && (d.links.size() < 3 || okTopicLink(d.links[2])));
    }
    // [TEMAT TRENINGU 2026-10-22] Opis pod tytułem (jak treść maila).
    // LUSTRO: src/utils/focus.ts (TOPIC_DESC_MAX).
    // [TYTUŁY LINKÓW 2026-10-22] tytuł przy linku (ten sam indeks), każdy ≤ 120 znaków.
    // LUSTRO: src/utils/focus.ts (TOPIC_LINK_TITLE_MAX).
    function okLinkTitle(x) {
      return x is string && x.size() <= 120;
    }
    function okTopicLinkTitles(d) {
      return !('linkTitles' in d)
        || (d.linkTitles is list
            && d.linkTitles.size() <= 3
            && (d.linkTitles.size() < 1 || okLinkTitle(d.linkTitles[0]))
            && (d.linkTitles.size() < 2 || okLinkTitle(d.linkTitles[1]))
            && (d.linkTitles.size() < 3 || okLinkTitle(d.linkTitles[2])));
    }
    function okTopicDesc(d) {
      return !('desc' in d) || (d.desc is string && d.desc.size() <= 1000);
    }
    // [NAZWA GRUPY 2026-10-23] uczeń nie czyta coachGroups trenera — nazwa na wpisie.
    // LUSTRO: src/utils/focus.ts (TOPIC_GROUP_NAME_MAX).
    function okTopicGroupName(d) {
      return !('groupName' in d) || (d.groupName is string && d.groupName.size() <= 60);
    }

    match /users/{uid}/coachLog/{entryId} {
      allow read: if isSelf(uid)
        || isAdmin()
        || (isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('coaches', []));

      allow create: if isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('coaches', [])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.get('text', '') is string
        && request.resource.data.get('text', '').size() >= 1
        && request.resource.data.get('text', '').size() <= 300
        && request.resource.data.get('type', '') in ['observation', 'tip', 'goal', 'flag', 'topic']
        // [DWA FOKUSY] liczba treningów fokusu trenera — na wpisie
        && request.resource.data.get('goal', 1) in [1, 2, 3, 4, 5]
        // [TEMAT TRENINGU 2026-10-15] dzień treningu 'YYYY-MM-DD'; bez
        // zamknięcia i potwierdzenia ucznia przy tworzeniu.
        && (request.resource.data.get('type', '') != 'topic'
            || (request.resource.data.get('day', '') is string
                && request.resource.data.get('day', '').size() == 10
                && !('closedAt' in request.resource.data)
                && !('ackAt' in request.resource.data)))
        && okTopicLinks(request.resource.data)
        && okTopicDesc(request.resource.data)
        && okTopicLinkTitles(request.resource.data)
        && okTopicGroupName(request.resource.data);

      // [TEMAT TRENINGU] Autor zmienia temat albo zamyka go (closedAt).
      allow update: if isSignedIn()
        && resource.data.authorId == request.auth.uid
        && resource.data.get('type', '') == 'topic'
        && request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('coaches', [])
        && onlyAffects(['text', 'topics', 'editedAt', 'closedAt', 'links', 'desc', 'linkTitles', 'groupName'])
        && okTopicLinks(request.resource.data)
        && okTopicDesc(request.resource.data)
        && okTopicLinkTitles(request.resource.data)
        && okTopicGroupName(request.resource.data)
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 300
        && request.resource.data.topics is list
        && request.resource.data.topics.size() <= 10
        && request.resource.data.get('editedAt', 0) is number
        && request.resource.data.get('closedAt', 0) is number;

      // [TEMAT TRENINGU] Uczeń potwierdza „Zapoznałem się” — tylko czas serwera.
      allow update: if isSelf(uid)
        && resource.data.get('type', '') == 'topic'
        && onlyAffects(['ackAt'])
        && request.resource.data.ackAt == request.time;

      // [C39] Autor fokusu (wpis 'goal') edytuje jego tytuł i temat — autor,
      // typ i data startu (createdAt = początek liczenia kropek) zostają,
      // więc postęp się nie resetuje. Autor musi nadal być trenerem ucznia.
      // [DWA FOKUSY 2026-10-14] Do tego: liczba treningów (goal), lekcje
      // zaznaczone przez trenera (marks — znaczniki czasu) i zakończenie
      // (endedAt + migawka ended) — bez ruszania własnego fokusu ucznia.
      allow update: if isSignedIn()
        && resource.data.authorId == request.auth.uid
        && resource.data.get('type', '') == 'goal'
        && request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('coaches', [])
        && onlyAffects(['text', 'topics', 'editedAt', 'goal', 'marks', 'endedAt', 'ended'])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 300
        && request.resource.data.topics is list
        && request.resource.data.topics.size() <= 10
        && request.resource.data.get('editedAt', 0) is number
        && request.resource.data.get('goal', 1) in [1, 2, 3, 4, 5]
        && request.resource.data.get('marks', []) is list
        && request.resource.data.get('marks', []).size() <= 50
        && request.resource.data.get('endedAt', 0) is number
        && request.resource.data.get('ended', {}) is map;

      allow delete: if isSelf(uid)
        || (isSignedIn() && resource.data.authorId == request.auth.uid)
        || isAdmin();
    }

    // ─── /users/{uid}/studentMessages/{studentId} ───────────────
    //  1-to-1 thread stored under coach's namespace (uid = coachId).
    //  Coach owns the document. Student may read/write replies only if
    //  they are in the coach's students[] list (prevents spoofing).
    match /users/{uid}/studentMessages/{studentId} {
      allow read, write: if isSelf(uid) || isAdmin();
      // Student can read/write their own thread — verified from both sides of the relation
      // to be robust against data inconsistency between students[] and coaches[].
      allow read, write: if isSignedIn()
        && request.auth.uid == studentId
        && (request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('students', [])
            || uid in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('coaches', []));
    }

    // ─── /users/{uid}/dailyStats/{day} ──────────────────────────
    match /users/{uid}/dailyStats/{day} {
      allow read, write: if isSelf(uid) || isAdmin();
    }

    // ─── Legacy subcol users/{uid}/scores — owner only ──────────
    match /users/{uid}/scores/{scoreId} {
      allow read, write: if isSelf(uid) || isAdmin();
    }

    // ─── /users/{uid}/tournaments/{eventId} ─────────────────────
    match /users/{uid}/tournaments/{eventId} {
      allow read: if isSelf(uid) || isAdmin()
        || (isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('coaches', []));
      allow write: if isSelf(uid) || isAdmin();

      // Kopie terminów trenera (coachCalendarMirror.ts): trener ucznia
      // tworzy/zmienia/usuwa WYŁĄCZNIE własne kopie (isMirrored + originCoachId).
      allow create, update: if isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('coaches', [])
        && (resource == null
            || (resource.data.get('isMirrored', false) == true
                && resource.data.get('originCoachId', '') == request.auth.uid))
        && validCoachMirror(request.resource.data);
      allow delete: if isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('coaches', [])
        && resource.data.get('isMirrored', false) == true
        && resource.data.get('originCoachId', '') == request.auth.uid;
    }

    // Kształt kopii z buildMirrorPayload (coachCalendarMirror.ts).
    function validCoachMirror(d) {
      return d.keys().hasOnly(['title', 'date', 'time', 'address', 'note', 'category',
                               'distance', 'type', 'originCoachId', 'originCoachName',
                               'originEventId', 'isMirrored', 'createdAt'])
        && d.isMirrored == true
        && d.originCoachId == request.auth.uid
        && d.category == 'Trener'
        && d.title is string && d.title.size() <= 200
        && d.date is string && d.date.size() <= 20
        && d.get('time', '') is string
        && d.get('address', '') is string && d.get('address', '').size() <= 500
        && d.get('note', '') is string && d.get('note', '').size() <= 5000
        && (d.get('distance', null) == null || d.distance is string)
        && d.get('type', '') is string
        && d.get('originCoachName', '') is string
        && d.originEventId is string;
    }

    // ─── /users/{uid}/privateNotes/{noteId}─────────────────────
    //  Student-only private notes. Coaches have NO access (by design) —
    //  z wyjątkiem wpisów, które uczeń sam udostępnił (shared: true).
    match /users/{uid}/privateNotes/{noteId} {
      allow read, create, delete: if isSelf(uid) || isAdmin();
      // [UDOSTĘPNIONY WPIS 2026-10-23] Uczeń sam decyduje (shared: true), że
      // wpis widzą jego trenerzy — tylko czytanie; reszta notatek bez zmian.
      allow read: if isSignedIn()
        && resource.data.get('shared', false) == true
        && request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('coaches', []);
      // Notatek nie edytujemy. Jedyny wyjątek: po rejestracji gościa
      // (clearGuestExpiry) właściciel zdejmuje expiresAt/isGuest, żeby TTL
      // nie skasował jego notatek — nic innego nie może się zmienić.
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt', 'isGuest'])
        && !('expiresAt' in request.resource.data)
        && !('isGuest' in request.resource.data);
      // [EDYCJA WPISU 2026-10-23] Właściciel poprawia własną notatkę: tekst,
      // tematy i znacznik Meilenstein. Wpisy fokusu (pole kind) — nie.
      allow update: if isSelf(uid)
        && resource.data.get('kind', '') == ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'topics', 'important', 'shared', 'editedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000
        && request.resource.data.get('topics', []) is list
        && request.resource.data.get('topics', []).size() <= 20
        && request.resource.data.get('important', false) is bool
        && request.resource.data.get('shared', false) is bool
        && request.resource.data.get('editedAt', 0) is number;
    }

    // ─── /users/{uid}/notifications/{notifId} ───────────────────
    //  In-app notification inbox. `uid` = recipient.
    //  Doc id is deterministic: `${type}_${refId}` — gives idempotent creation.
    //  Authoritative source for the bell icon (cross-device sync).
    //
    //  Read:   recipient or admin
    //  Create: sender with valid relationship to recipient (per type)
    //  Update: recipient only, only readAt field (mark as read)
    //  Delete: recipient or admin (used for pruning + manual dismiss)
    match /users/{uid}/notifications/{notifId} {
      allow read: if isSelf(uid) || isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.type in ['message', 'coach_note', 'coach_log', 'coach_plan', 'announcement', 'coach_request']
        && request.resource.data.refId is string
        && request.resource.data.refId.size() > 0
        && request.resource.data.refId.size() <= 200
        && request.resource.data.icon is string
        && request.resource.data.iconColor is string
        && request.resource.data.navigateTo in ['MY_COACH', 'COACH', 'ANNOUNCEMENTS', 'ADMIN', 'CALENDAR']
        && request.resource.data.readAt == null
        && (
          // Self-sync: user writes to own inbox (e.g. HomeView catching ALL/CLUB announcements).
          // Trust boundary: user can only spam their own inbox — no privilege escalation.
          isSelf(uid)
          ||
          // message: sender must be in coach-student relation with recipient
          (request.resource.data.type == 'message'
           && (request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('coaches', [])
               || request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('students', [])))
          ||
          // coach_note: sender is coach of recipient (note on student's training session)
          (request.resource.data.type == 'coach_note'
           && request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('coaches', []))
          ||
          // coach_log: sender is coach of recipient (entry in shared Trainer-Tagebuch)
          (request.resource.data.type == 'coach_log'
           && request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('coaches', []))
          ||
          // coach_plan: sender is coach of recipient
          (request.resource.data.type == 'coach_plan'
           && request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('coaches', []))
          ||
          // announcement: admin can notify anyone; coach can notify their students
          (request.resource.data.type == 'announcement'
           && (isAdmin()
               || request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('coaches', [])))
          ||
          // coach_request: any signed-in user can notify the admin recipient
          (request.resource.data.type == 'coach_request'
           && uid == 'b55wNdZf17gH5wxziuzG9bkaQKo2')
        );

      // Recipient marks as read — only readAt may change.
      allow update: if isSelf(uid)
        && onlyAffects(['readAt']);

      allow delete: if isSelf(uid) || isAdmin();
    }

    // ─── /coachInvites/{inviteId}  (doc id = "{coachId}_{studentId}") ─
    match /coachInvites/{inviteId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.coachId ||
        request.auth.uid == resource.data.studentId
      );
      allow create: if isSignedIn()
        && !isAnon()
        && request.resource.data.coachId == request.auth.uid
        && inviteId == request.resource.data.coachId + '_' + request.resource.data.studentId
        && request.resource.data.studentId is string
        && request.resource.data.studentId != request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.coachId ||
        request.auth.uid == resource.data.studentId
      );
    }

    // ─── /battles/{battleId} ────────────────────────────────────
    match /battles/{battleId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && !isAnon()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.status in ['LOBBY', 'ACTIVE', 'START'];

      // Host full control of own battle
      allow update: if isSignedIn()
        && resource.data.hostId == request.auth.uid;

      // Participant — ONLY own liveScore changes; po ukończeniu wynik jest
      // zamrożony (ponowne wejście w grę nadpisywało go zerem).
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.get('participants', [])
        && !(request.auth.uid in resource.data.get('finishedParticipants', []))
        && onlyAffects(['liveScores'])
        && request.resource.data.liveScores.diff(resource.data.get('liveScores', {}))
             .affectedKeys().hasOnly([request.auth.uid]);

      // JOIN — dołączenie samego siebie (kafel Verein/World na Home, kod gry).
      // Wcześniej mógł to zrobić tylko host albo zaproszony, więc klik w cudzą
      // grę klubową po cichu nic nie robił. Dopisać można wyłącznie siebie:
      // na koniec listy, z własnym wpisem w liveScores/participantsData/distances.
      allow update: if isSignedIn()
        && !isAnon()
        && resource.data.status in ['LOBBY', 'ACTIVE', 'START']
        && !(request.auth.uid in resource.data.get('participants', []))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['participants', 'liveScores', 'participantsData', 'distances'])
        && request.resource.data.participants == resource.data.get('participants', []).concat([request.auth.uid])
        // [VEREIN] maks. 12 graczy w grze (CLUB_MAX_PLAYERS w utils/battleStage.ts)
        && request.resource.data.participants.size() <= 12
        && request.resource.data.get('liveScores', {}).diff(resource.data.get('liveScores', {}))
             .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.get('participantsData', {}).diff(resource.data.get('participantsData', {}))
             .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.get('distances', {}).diff(resource.data.get('distances', {}))
             .affectedKeys().hasOnly([request.auth.uid]);

      // Participant — oznacza SIEBIE jako ukończonego. Wcześniej mógł to tylko
      // host, więc gracz nigdy nie był „ukończony": mógł wejść drugi raz
      // (wynik → 0) i nie widział pełnego rankingu na ślepo.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.get('participants', [])
        && !(request.auth.uid in resource.data.get('finishedParticipants', []))
        && onlyAffects(['finishedParticipants'])
        && request.resource.data.finishedParticipants
             == resource.data.get('finishedParticipants', []).concat([request.auth.uid]);

      // [ZAMYKANIE] Gra kończy się statusem FINISHED — wcześniej zostawała
      // „aktywna” na zawsze i lista bitew rosła bez końca. Tylko sam status:
      //  - pojedynek/World: uczestnik, gdy WSZYSCY uczestnicy skończyli,
      //  - po terminie gry (expiresAtMs, liczba): każdy zalogowany.
      // Gra klubowa nie zamyka się przed terminem, bo dochodzą do niej nowi.
      allow update: if isSignedIn()
        && onlyAffects(['status'])
        && request.resource.data.status == 'FINISHED'
        && resource.data.status in ['LOBBY', 'ACTIVE', 'START']
        && (
          (request.auth.uid in resource.data.get('participants', [])
            && resource.data.get('mode', 'LOCAL') != 'CLUB'
            && resource.data.get('finishedParticipants', []).toSet()
                 .hasAll(resource.data.get('participants', [])))
          || (resource.data.get('expiresAtMs', 0) is int
            && resource.data.get('expiresAtMs', 0) > 0
            && request.time.toMillis() > resource.data.get('expiresAtMs', 0))
        );

      // Participant — ONLY own distance (w bitwie wspólna jest tarcza, dystans
      // każdy ma swój, np. senior 60 m vs młodzik 70 m na 122 cm)
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.get('participants', [])
        && onlyAffects(['distances'])
        && request.resource.data.distances.diff(resource.data.get('distances', {}))
             .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.distances[request.auth.uid] is string
        && request.resource.data.distances[request.auth.uid].size() <= 60;

      // Invited — ACCEPT: diff keys ⊆ [participants, pendingInvites, liveScores];
      //                    self is in pendingInvites; self will be in participants; self not yet
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.get('pendingInvites', [])
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['participants', 'pendingInvites', 'liveScores'])
        && request.resource.data.participants.size() <= 12
        && !(request.auth.uid in resource.data.get('participants', []))
        && request.auth.uid in request.resource.data.get('participants', [])
        && !(request.auth.uid in request.resource.data.get('pendingInvites', []));

      // Invited — REJECT
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.get('pendingInvites', [])
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['pendingInvites', 'participantsData'])
        && !(request.auth.uid in request.resource.data.get('pendingInvites', []));

      // Host usuwa grę, dopóki nikt poza nim nie dołączył i nikt jej nie
      // ukończył — inaczej kasowałby wyniki innych.
      allow delete: if isSignedIn()
        && resource.data.hostId == request.auth.uid
        && resource.data.get('finishedParticipants', []).size() == 0
        && (resource.data.status in ['LOBBY', 'START']
            || (resource.data.status == 'ACTIVE' && resource.data.get('participants', []).size() <= 1));
    }

    // ─── /world_queue/{userId} — private matchmaking entry ──────
    match /world_queue/{entryId} {
      allow read: if isSelf(entryId) || isAdmin();
      allow create: if isSelf(entryId)
        && !isAnon()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSelf(entryId) && !isAnon();
      allow delete: if isSelf(entryId) || isAdmin();
    }

    // ─── /world_stats/{userId} — public leaderboard, bounded writes ─
    match /world_stats/{userId} {
      allow read: if isSignedIn();

      // Create z ograniczeniami zamiast zer: updateWorldStatsOnly tworzy
      // dokument dopiero PO pierwszej bitwie (od razu z 1 win/loss + XP) —
      // wymóg samych zer po cichu odrzucał pierwszy zapis na leaderboard.
      allow create: if isSelf(userId)
        && !isAnon()
        && validWorldStatsShape(request.resource.data)
        && request.resource.data.get('worldWins', 0) >= 0
        && request.resource.data.get('worldWins', 0) <= 1
        && request.resource.data.get('worldLosses', 0) >= 0
        && request.resource.data.get('worldLosses', 0) <= 1
        && request.resource.data.get('worldXP', 0) >= 0
        && request.resource.data.get('worldXP', 0) <= 100;

      // Per-update bounds: at most +1 win, +1 loss, +100 XP, no decrements.
      allow update: if isSelf(userId)
        && !isAnon()
        && validWorldStatsShape(request.resource.data)
        && request.resource.data.get('worldWins', 0)
             >= resource.data.get('worldWins', 0)
        && request.resource.data.get('worldWins', 0)
             <= resource.data.get('worldWins', 0) + 1
        && request.resource.data.get('worldLosses', 0)
             >= resource.data.get('worldLosses', 0)
        && request.resource.data.get('worldLosses', 0)
             <= resource.data.get('worldLosses', 0) + 1
        && request.resource.data.get('worldXP', 0)
             >= resource.data.get('worldXP', 0)
        && request.resource.data.get('worldXP', 0)
             <= resource.data.get('worldXP', 0) + 100;

      // Właściciel może usunąć własny wpis (RODO art. 17 — usuwanie konta).
      allow delete: if isSelf(userId) || isAdmin();
    }

    // ─── /clubs/{clubId} ────────────────────────────────────────
    match /clubs/{clubId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.keys().hasOnly(
             ['name', 'city', 'country', 'placeId', 'createdAt', 'createdBy']
           );
      allow update, delete: if isAdmin();
    }

    // ─── /announcements/{id} ────────────────────────────────────
    match /announcements/{id} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.get('type', '') == 'coach'
        && request.resource.data.get('authorId', '') == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.get('authorId', '') == request.auth.uid);
    }

    // ─── /coachRequests/{id} ────────────────────────────────────
    //  [RODO C36] Imię + e-mail — polityka §2.4: widzi tylko admin, max
    //  6 miesięcy (expiresAt → TTL), właściciel kasuje przy usunięciu konta.
    match /coachRequests/{id} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(
             ['userId', 'userName', 'userEmail', 'desiredStudents', 'status', 'timestamp', 'expiresAt']);
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ─── /admin_stats_history/{id} ──────────────────────────────
    match /admin_stats_history/{id} {
      allow read, write: if isAdmin();
    }

    // ─── Default deny ───────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
