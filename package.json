{
  "name": "vite-react-typescript-starter",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/icon-font.mjs --check && node scripts/i18n-parity.mjs && vite build && node scripts/generate-sw.mjs",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "test:rules": "firebase emulators:exec --only firestore --project grotx-rules-test \"node --test tests/rules/firestore.rules.test.mjs\"",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "prepare": "husky",
    "icons:update": "node scripts/icon-font.mjs --update"
  },
  "dependencies": {
    "firebase": "^12.11.0",
    "html5-qrcode": "^2.3.8",
    "i18next": "^23.10.0",
    "i18next-browser-languagedetector": "^7.2.0",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "qrcode.react": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.0",
    "react-router-dom": "^6.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.15.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.4.6",
    "tailwindcss": "^3.0.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^6.4.3"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint"
    ]
  },
  "type": "module"
}
